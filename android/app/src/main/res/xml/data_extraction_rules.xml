<?xml version="1.0" encoding="utf-8"?>
<!--
    Session tokens are encrypted with a device-bound Keystore key, so they must never leave the device.
    The offline copy of the collection belongs to that session; a new device syncs it from the server.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
