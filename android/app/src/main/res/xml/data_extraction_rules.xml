<?xml version="1.0" encoding="utf-8"?>
<!-- Session tokens are encrypted with a device-bound Keystore key, so they must never leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
