# Copy to .env and adjust. Matches the database from the root docker-compose.yml.
DATABASE_URL="postgresql://gameshelf:gameshelf@localhost:5432/game_shelf"
# Local PostgreSQL without Docker (`make db-local`, e.g. Homebrew): your OS user name, no password.
# DATABASE_URL="postgresql://your-user@localhost:5432/game_shelf"

# Generate e.g. with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Access token lifetime in seconds, refresh token lifetime in days.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

PORT=3000

# Behind a reverse proxy (load balancer, nginx …) set e.g. TRUST_PROXY=1
# TRUST_PROXY=1

# Barcode lookup (GET /lookup/barcode/{barcode}). Works without any key using UPCitemdb's free
# trial (100 lookups a day); a paid plan's key raises the limit.
# UPCITEMDB_USER_KEY=
# IGDB adds genre, developer, publisher, release year and cover to barcode lookups, and is the database
# behind searching games by title (GET /lookup/games), which does not work without it. Free: register
# an application at https://dev.twitch.tv/console and copy its Client ID and a new Client Secret.
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=
