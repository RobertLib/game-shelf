# Copy to .env and adjust. Matches the database from the root docker-compose.yml.
DATABASE_URL="postgresql://gameshelf:gameshelf@localhost:5432/game_shelf"
# Local PostgreSQL without Docker (`make db-local`, e.g. Homebrew): your OS user name, no password.
# DATABASE_URL="postgresql://your-user@localhost:5432/game_shelf"

# Generate e.g. with: openssl rand -base64 48 (with NODE_ENV=production this example value is refused)
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Access token lifetime in seconds, refresh token lifetime in days.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# A refresh token sent again within this many seconds after it was exchanged (a retry when the
# response got lost) gets a new pair instead of signing out every session. 0 turns this off.
# REFRESH_TOKEN_REUSE_GRACE_SECONDS=120

PORT=3000

# `production` hides the API docs (unless SWAGGER_ENABLED=true) and refuses the example JWT_SECRET.
# NODE_ENV=production
# Swagger UI and the OpenAPI document at /docs; default true, false with NODE_ENV=production.
# SWAGGER_ENABLED=true

# Behind a reverse proxy (load balancer, nginx …) set e.g. TRUST_PROXY=1
# TRUST_PROXY=1

# Barcode lookup (GET /lookup/barcode/{barcode}). Works without any key using UPCitemdb's free
# trial (100 lookups a day); a paid plan's key raises the limit.
# UPCITEMDB_USER_KEY=
# UPCitemdb lookups one user can cause per day (cached results are free), so that a single account
# cannot use up the shared quota.
# UPCITEMDB_DAILY_LIMIT_PER_USER=20
# IGDB adds genre, developer, publisher, release year and cover to barcode lookups, and is the database
# behind searching games by title (GET /lookup/games), which does not work without it. Free: register
# an application at https://dev.twitch.tv/console and copy its Client ID and a new Client Secret.
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=
