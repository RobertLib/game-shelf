generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String    @id @default(uuid(7)) @db.Uuid
  /// Always stored lower-cased and trimmed.
  email             String    @unique
  passwordHash      String
  displayName       String?
  /// Access tokens issued before this moment are rejected.
  passwordChangedAt DateTime?
  /// Last change number handed out to this user's games (see `Game.version`).
  gamesVersion      Int       @default(0)
  /// Part of every change feed cursor. Replaced after restoring the database from a backup
  /// (`npm run db:reset-sync`), so that cursors issued before the restore are answered with 410.
  syncEpoch         String    @default(dbgenerated("substr(md5((random())::text), 1, 10)"))
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  games         Game[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @db.Uuid
  /// SHA-256 of the opaque token handed to the client; the token itself is never stored.
  tokenHash    String    @unique
  expiresAt    DateTime
  /// Set when the token is rotated or the session is signed out.
  revokedAt    DateTime?
  /// The token this one was rotated to; null when it was revoked by signing out.
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Game {
  id              String           @id @default(uuid(7)) @db.Uuid
  userId          String           @db.Uuid
  title           String
  platform        Platform
  status          CollectionStatus @default(OWNED)
  format          GameFormat       @default(PHYSICAL)
  region          Region?
  edition         String?
  completeness    Completeness?
  condition       Condition?
  playStatus      PlayStatus?
  genre           String?
  developer       String?
  publisher       String?
  releaseYear     Int?
  /// EAN / UPC printed on the box.
  barcode         String?
  /// Catalogue / serial number printed on the media or spine, e.g. SLES-50330.
  productCode     String?
  quantity        Int              @default(1)
  purchasePrice   Decimal?         @db.Decimal(12, 2)
  purchaseDate    DateTime?        @db.Date
  purchasePlace   String?
  estimatedValue  Decimal?         @db.Decimal(12, 2)
  /// Currency of both prices: 3 letters A–Z, upper-case – an ISO 4217 code, historic ones
  /// such as DEM or SKK included.
  currency        String           @default("CZK") @db.Char(3)
  storageLocation String?
  /// Personal rating 1–10.
  rating          Int?             @db.SmallInt
  favorite        Boolean          @default(false)
  coverImageUrl   String?
  notes           String?
  /// Number of the last change (create, update or delete) within the owner's games, taken from
  /// `User.gamesVersion`. The change feed for offline clients is ordered by it.
  version         Int
  /// Set when the game is deleted. The row stays as a tombstone so that other devices learn about
  /// the deletion from the change feed; everything else treats it as non-existent, and its
  /// optional columns are cleared.
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, version])
  @@index([userId, title])
  @@index([userId, platform])
  @@index([userId, createdAt])
  @@map("games")
}

enum Platform {
  // PC & Apple
  PC
  MAC
  // Sony
  PS1
  PS2
  PS3
  PS4
  PS5
  PSP
  PS_VITA
  // Microsoft
  XBOX
  XBOX_360
  XBOX_ONE
  XBOX_SERIES
  // Nintendo
  NES
  SNES
  N64
  GAMECUBE
  WII
  WII_U
  SWITCH
  SWITCH_2
  GAME_BOY
  GAME_BOY_COLOR
  GAME_BOY_ADVANCE
  NINTENDO_DS
  NINTENDO_3DS
  VIRTUAL_BOY
  // Sega
  MASTER_SYSTEM
  MEGA_DRIVE
  MEGA_CD
  SEGA_32X
  SATURN
  DREAMCAST
  GAME_GEAR
  // Atari
  ATARI_2600
  ATARI_7800
  ATARI_LYNX
  ATARI_JAGUAR
  // Other consoles
  NEO_GEO
  NEO_GEO_POCKET
  PC_ENGINE
  THREE_DO
  // Home computers
  ZX_SPECTRUM
  COMMODORE_64
  AMIGA
  AMSTRAD_CPC
  ATARI_8BIT
  ATARI_ST
  MSX
  OTHER
}

enum CollectionStatus {
  OWNED
  WISHLIST
  PREORDERED
  LENT
  FOR_SALE
  SOLD
}

enum GameFormat {
  PHYSICAL
  DIGITAL
}

enum Region {
  PAL
  NTSC_U
  NTSC_J
  REGION_FREE
  OTHER
}

enum Completeness {
  SEALED
  CIB
  GAME_AND_BOX
  GAME_AND_MANUAL
  LOOSE
  BOX_ONLY
}

enum Condition {
  MINT
  NEAR_MINT
  VERY_GOOD
  GOOD
  FAIR
  POOR
}

enum PlayStatus {
  UNPLAYED
  PLAYING
  COMPLETED
  ABANDONED
}
