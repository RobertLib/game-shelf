# Ignore rules for the whole monorepo (api/, android/, ios/) live in this one file.

# --- OS & editors ------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~
*.log
.idea/
*.iml
.vscode/*
!.vscode/extensions.json

# --- Secrets & local configuration -------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
local.properties
*.keystore
*.jks
*.p12
*.mobileprovision

# --- api/ (NestJS, Prisma) ---------------------------------------------------
node_modules/
api/dist/
api/coverage/
# Prisma client, regenerated by `npm install` (postinstall) or `npx prisma generate`
api/src/generated/
*.tsbuildinfo

# --- android/ (Gradle) -------------------------------------------------------
.gradle/
.kotlin/
android/**/build/
android/captures/
android/.externalNativeBuild/
android/.cxx/

# --- ios/ (Xcode) ------------------------------------------------------------
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
DerivedData/
ios/build/
.build/
.swiftpm/
*.xcresult
*.ipa
*.dSYM
*.dSYM.zip
